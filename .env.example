# Feature switches. false = personal tool: no plans or payments (everything unlocked for
# every account) and no AI (no Claude calls). Set both to true to run it as the SaaS.
FEATURE_BILLING=false
FEATURE_AI=false

# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL. Use a long random password with letters and digits only
# (it is placed inside a connection URL, so avoid @ : / % # ? characters).
POSTGRES_USER=nis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nis

# Signs login tokens. Must be a long random value; anyone who knows it can sign in as any
# user. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# How long a login lasts. The refresh cookie is a session cookie unless the person ticks
# "Keep me signed in", so closing the browser normally ends the session; these are the
# outer limits for the ones that do persist.
# SESSION_TTL_DAYS=30            # absolute cap on one login, remembered or not
# REFRESH_IDLE_TIMEOUT_HOURS=12  # unused this long -> must sign in again
# ACCESS_TOKEN_TTL_SECONDS=900   # lifetime of one JWT
# Set false to refuse "Keep me signed in" account-wide: every session then ends with the
# browser. Worth doing if the app is used on shared machines.
# ALLOW_PERSISTENT_SESSIONS=true

# Telegram alerts (optional). Create a bot with @BotFather in Telegram, then paste its token
# and username (without the @). Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional: "Continue with Google". Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this Authorized redirect URI:
#   <APP_BASE_URL>/api/auth/google/callback   e.g. http://localhost:8081/api/auth/google/callback
# Open the app on that same host (localhost vs 127.0.0.1 matter: cookies are per host).
# Without these the button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the callback differs from <APP_BASE_URL>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# AI summaries with Claude (optional). Get a key at https://platform.claude.com. Leave empty
# to run without AI. The worker stops for the day (India time) once estimated spend reaches
# the budget. claude-haiku-5-5 is ~40x cheaper per story than the default, if quality holds.
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=3
# "Ask the news" and the 8:30 pre-market brief have their own model and daily budget.
AI_AGENT_MODEL=claude-opus-5-5
AI_AGENT_DAILY_BUDGET_USD=5

# Payments with Razorpay Subscriptions (optional). Use test-mode keys (rzp_test_...) until
# launch. In the Razorpay dashboard: create a monthly plan for Pro and for Pro+ (amounts must
# match the prices on our pricing page) and paste their plan ids; add a webhook to
# https://<your domain>/api/billing/webhook for the subscription.* events, with a secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_PRO_PLUS=
# Days of free Pro for new accounts (0 = none).
TRIAL_DAYS=7

# Emails (verify email, reset password, billing notices). Links in emails point to
# APP_BASE_URL. With EMAIL_PROVIDER=console nothing is sent: emails appear in the worker log
# (docker compose logs worker) and at http://127.0.0.1:8001/api/dev/emails.
APP_BASE_URL=http://127.0.0.1:8081
EMAIL_PROVIDER=console
EMAIL_FROM=News Intelligence <no-reply@example.com>
EMAIL_REPLY_TO=
# Any SMTP service works. Free options (set EMAIL_PROVIDER=smtp):
#   Brevo (300 emails/day free): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#     SMTP_USERNAME=<your Brevo SMTP login> SMTP_PASSWORD=<SMTP key>  (verify your sender)
#   Gmail (~500/day, for testing): SMTP_HOST=smtp.gmail.com SMTP_PORT=587
#     SMTP_USERNAME=you@gmail.com SMTP_PASSWORD=<16-letter App Password; needs 2-Step
#     Verification>. EMAIL_FROM must be that Gmail address.
#   Resend (3,000/month free): SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USERNAME=resend
#     SMTP_PASSWORD=<API key re_...>  (verify your domain first)
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# Ports published on 127.0.0.1. Change them if something on your machine already uses them.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=8080

# Running the backend directly on your machine (outside Docker) uses these instead:
# DATABASE_URL=postgresql+asyncpg://nis:change-me@localhost:5432/nis
# REDIS_URL=redis://localhost:6379/0

# Security
# Encrypts two-step sign-in secrets. Required in production. Generate once and keep it
# (changing it later turns off everyone's two-step sign-in):
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
# Admins must use two-step sign-in. Empty = required everywhere except local/test.
ADMIN_REQUIRE_2FA=

# --------------------------------------------------------------------------- production
# Used by docker-compose.prod.yml (see README, "Deploying"). Not needed for development.
# Your domain; its DNS A record must point at the server. Caddy gets the HTTPS certificate.
DOMAIN=
# Let's Encrypt contact for certificate notices.
ACME_EMAIL=
# Error monitoring (optional): a Sentry project DSN. Free tier is enough to start.
SENTRY_DSN=
# Daily database backups into ./backups (hour in UTC; 21 = 02:30 IST).
BACKUP_HOUR=21
BACKUP_KEEP_DAYS=14
# Run published images instead of building on the server (from the Release workflow), e.g.
#   BACKEND_IMAGE=ghcr.io/<you>/<repo>-backend:1.0.0
#   WEB_IMAGE=ghcr.io/<you>/<repo>-web:1.0.0
BACKEND_IMAGE=
WEB_IMAGE=
APP_VERSION=
